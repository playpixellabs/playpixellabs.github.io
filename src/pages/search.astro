---
import Layout from "../layouts/Layout.astro";
import SearchHeader from "../components/search/SearchHeader.astro";
import DiscoverySection from "../components/search/DiscoverySection.astro";
/* Force HMR */
---

<Layout title="Search - PlayPixelLabs">
    <div class="search-page-container">
        <SearchHeader />
        <DiscoverySection />
    </div>
</Layout>

<style>
    .search-page-container {
        padding: 1rem 1rem;
        max-width: 600px;
        margin: 0 auto;
        padding-bottom: 80px; /* Nav bar space */
        padding-top: 100px; /* Header space: 52px input + 2rem padding + gap */
    }
</style>
