---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import GameRow from "../components/GameRow.astro";
import CategoryFilter from "../components/CategoryFilter.astro";

// Mock Data
const featuredGames = [
	{
		title: "Neon Runner",
		category: "Action",
		image: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=800&auto=format&fit=crop",
		slug: "neon-runner",
		rating: 4.8,
	},
	{
		title: "Space Shooter",
		category: "Arcade",
		image: "https://images.unsplash.com/photo-1551103782-8ab07afd45c1?q=80&w=800&auto=format&fit=crop",
		slug: "space-shooter",
		rating: 4.6,
	},
	{
		title: "Snake Classic",
		category: "Arcade",
		image: "https://images.unsplash.com/photo-1628277613967-6ab58cf56736?q=80&w=800&auto=format&fit=crop",
		slug: "snake",
		rating: 4.2,
	},
];

const puzzleGames = [
	{
		title: "Memory Match",
		category: "Puzzle",
		image: "https://images.unsplash.com/photo-1606167668584-78701c57f13d?q=80&w=800&auto=format&fit=crop",
		slug: "memory-match",
		rating: 4.5,
	},
	{
		title: "2048",
		category: "Puzzle",
		image: "https://images.unsplash.com/photo-1612404730960-5c71579fca2c?q=80&w=800&auto=format&fit=crop",
		slug: "2048",
		rating: 4.7,
	},
	{
		title: "Tetris",
		category: "Arcade",
		image: "https://images.unsplash.com/photo-1579373903781-fd5c0c30c4cd?q=80&w=800&auto=format&fit=crop",
		slug: "tetris",
		rating: 4.9,
	},
];

const strategyGames = [
	{
		title: "Chess",
		category: "Strategy",
		image: "https://images.unsplash.com/photo-1529699211952-734e80c4d42b?q=80&w=800&auto=format&fit=crop",
		slug: "chess",
		rating: 4.8,
	},
	{
		title: "Neon Runner",
		category: "Action",
		image: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=800&auto=format&fit=crop",
		slug: "neon-runner",
		rating: 4.8,
	},
	{
		title: "Space Shooter",
		category: "Arcade",
		image: "https://images.unsplash.com/photo-1551103782-8ab07afd45c1?q=80&w=800&auto=format&fit=crop",
		slug: "space-shooter",
		rating: 4.6,
	},
];
---

<Layout title="PlayPixelLabs">
	<Header />

	<main>
		<!-- Categories Pill Row (Optional, if we keep filter, check style) -->
		<CategoryFilter />

		<!-- Featured Section (Wide Cards) -->
		<GameRow
			title="Featured Games"
			games={featuredGames}
			cardSize="feature"
		/>

		<!-- Standard Sections -->
		<GameRow
			title="Recommended for you"
			games={[...puzzleGames, ...strategyGames]}
			cardSize="standard"
		/>

		<GameRow
			title="Puzzle & Logic"
			games={puzzleGames}
			cardSize="standard"
		/>

		<GameRow
			title="Strategy & Tactics"
			games={strategyGames}
			cardSize="standard"
		/>
	</main>
</Layout>

<style>
	main {
		padding-top: 1rem;
	}
</style>
