---
import { Search, Menu, Gamepad2 } from "lucide-astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header glass">
    <div class="container header-content">
        <a href="/" class="logo">
            <div class="logo-icon">
                <Gamepad2 size={24} />
            </div>
            <span class="logo-text"
                >pixel<span class="highlight">Play</span></span
            >
        </a>

        <div class="search-bar">
            <Search size={20} class="search-icon" />
            <input type="text" placeholder="Search games and genres" />
        </div>

        <nav class="desktop-nav">
            <a href="/playlists">Playlists</a>
            <ThemeToggle />
            <button class="menu-btn">
                <Menu size={24} />
            </button>
        </nav>
    </div>
</header>

<style>
    .header {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.5rem;
    }

    .logo-icon {
        background: white;
        color: var(--color-primary);
        padding: 0.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .logo-text {
        color: var(--color-text);
    }

    .highlight {
        color: var(--color-text-muted); /* Or maybe white/bold */
        font-weight: 900;
    }

    .search-bar {
        flex: 1;
        max-width: 500px;
        position: relative;
        display: none; /* Hidden on mobile initially */
    }

    @media (min-width: 768px) {
        .search-bar {
            display: block;
        }
    }

    .search-bar input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border-radius: 50px;
        border: none;
        background: rgba(255, 255, 255, 0.9);
        color: #333;
        font-family: var(--font-body);
        font-size: 1rem;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .menu-btn {
        background: none;
        border: none;
        color: var(--color-text);
        display: none; /* Hidden on desktop if not needed, or visible for drawer */
    }
</style>
