---
const categories = [
    { name: "For you", active: true },
    { name: "Top charts", active: false },
    { name: "Kids", active: false },
    { name: "Premium", active: false },
    { name: "Categories", active: false },
    { name: "Editors' Choice", active: false },
];
---

<div class="category-filter">
    <div class="container no-padding">
        <div class="scroll-wrapper">
            {
                categories.map((cat) => (
                    <button
                        class={`category-pill ${cat.active ? "active" : ""}`}
                    >
                        {cat.name}
                    </button>
                ))
            }
        </div>
    </div>
</div>

<style>
    .category-filter {
        padding: 0.5rem 0 1rem;
        /* position: sticky;  <-- Removed per user request */
        /* top: 0; */
        z-index: 90;
        background-color: var(--color-bg);
    }

    @media (min-width: 900px) {
        .category-filter {
            top: 105px; /* Adjust for sticky header height on desktop */
        }
    }

    .container.no-padding {
        padding: 0;
    }

    .scroll-wrapper {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding: 0 1.5rem;
        scrollbar-width: none; /* Firefox */
    }

    .scroll-wrapper::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .category-pill {
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        padding: 0.4rem 1rem;
        border-radius: 50px;
        white-space: nowrap;
        font-family: "Google Sans", sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .category-pill:hover {
        background-color: var(--color-surface-hover);
        color: var(--color-text);
    }

    .category-pill.active {
        background-color: #e6f3ef; /* Light green tint */
        color: var(--color-primary);
        border-color: transparent;
    }

    [data-theme="dark"] .category-pill.active {
        background-color: #1a2a22; /* Dark green tint */
        color: #81c995; /* Lighter green text */
    }
</style>
