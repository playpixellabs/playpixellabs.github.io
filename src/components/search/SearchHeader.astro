---
import { Search, Mic, X } from "lucide-astro";
import { games } from "../../data/games";
import ThemeToggle from "../ThemeToggle.astro";
---

<div class="search-page-header">
    <div class="search-input-wrapper">
        <div class="search-input-container">
            <Search size={22} color="var(--color-text-secondary)" />
            <input
                type="text"
                placeholder="Search apps & games"
                class="search-input"
                id="page-search-input"
                autocomplete="off"
            />
            <button class="clear-btn hidden" id="page-search-clear">
                <X size={20} color="var(--color-text-secondary)" />
            </button>
        </div>

        <!-- Search Results Dropdown -->
        <div class="page-search-results hidden" id="page-search-results"></div>
    </div>

    <!-- Theme Toggle -->
    <div class="actions">
        <ThemeToggle />
    </div>
</div>

<script define:vars={{ games }}>
    const searchInput = document.getElementById("page-search-input");
    const searchResults = document.getElementById("page-search-results");
    const clearBtn = document.getElementById("page-search-clear");
    const header = document.querySelector(".search-page-header");

    // Add scroll shadow effect
    window.addEventListener("scroll", () => {
        if (window.scrollY > 0) {
            header?.classList.add("scrolled");
        } else {
            header?.classList.remove("scrolled");
        }
    });

    searchInput?.addEventListener("input", (e) => {
        const query = e.target.value.toLowerCase();

        if (query.length > 0) {
            clearBtn?.classList.remove("hidden");
            const results = games.filter(
                (g) =>
                    g.title.toLowerCase().includes(query) ||
                    g.category.toLowerCase().includes(query),
            );

            if (results.length > 0) {
                searchResults.classList.remove("hidden");
                searchResults.innerHTML = results
                    .map(
                        (g) => `
                    <a href="/play/${g.slug}" class="page-search-item">
                        <div class="page-search-img-wrapper" style="width: 60px; height: 60px; min-width: 60px; border-radius: 8px; overflow: hidden; background: #f0f0f0;">
                            <img src="${g.image}" alt="${g.title}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div class="search-info">
                            <div class="search-title">${g.title}</div>
                            <div class="search-meta">
                                <span class="search-cat">${g.category}</span>
                                <div class="search-rating">
                                    <span class="star-icon">★</span>
                                    <span>${g.rating || 4.5}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                `,
                    )
                    .join("");
            } else {
                searchResults.classList.remove("hidden");
                searchResults.innerHTML = `<div class="no-results">No results for "${query.replace(/</g, "")}"</div>`;
            }
        } else {
            clearBtn?.classList.add("hidden");
            searchResults.classList.add("hidden");
        }
    });

    clearBtn?.addEventListener("click", () => {
        if (searchInput) {
            searchInput.value = "";
            searchInput.focus();
        }
        searchResults?.classList.add("hidden");
        clearBtn?.classList.add("hidden");
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
        if (
            !searchInput?.contains(e.target) &&
            !searchResults?.contains(e.target)
        ) {
            searchResults?.classList.add("hidden");
        }
    });
</script>

<style>
    .search-page-header {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1rem;
        position: sticky;
        top: 0;
        z-index: 1000;
        background-color: var(--color-bg);
        transition: box-shadow 0.2s;
        /* Padding to balance */
        padding-top: 1rem;
        /* Negative margins to span full width if parent has padding */
        margin-left: -1rem;
        margin-right: -1rem;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .search-page-header.scrolled {
        box-shadow: 0 4px 20px -10px rgba(0, 0, 0, 0.1);
        margin-left: -1rem; /* Hacky expansion if inside container padding */
        margin-right: -1rem;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    /* Better sticky handling: If body/main has padding */

    .search-input-wrapper {
        flex: 1;
        position: relative;
    }

    .search-input-container {
        display: flex;
        align-items: center;
        background: var(--color-surface-hover);
        padding: 0 1rem;
        height: 52px;
        border-radius: 26px; /* Pill shape */
        gap: 0.75rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); /* Subtle shadow like play store */
        position: relative;
        z-index: 51;
        transition: border-radius 0.2s;
    }

    /* When results are open, maybe make rectangle? keeping pill for now as play store does */

    .search-input {
        flex: 1;
        border: none;
        background: transparent;
        height: 100%;
        font-family: "Google Sans", sans-serif;
        font-size: 1.1rem;
        color: var(--color-text);
        outline: none;
    }

    .clear-btn {
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .mic-icon {
        /* Only show if input empty? Play store keeps it usually unless typing long */
    }

    .user-avatar-small {
        width: 36px;
        height: 36px;
        background: #00875a; /* Generic user color */
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        font-size: 1rem;
        flex-shrink: 0;
        margin-top: 8px; /* Align with input */
    }

    .hidden {
        display: none !important;
    }

    /* Results Dropdown */
    .page-search-results {
        position: absolute;
        top: 60px; /* Below input */
        left: 0;
        right: 0;
        background: var(--color-surface);
        border-radius: 16px;
        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.15),
            0 0 0 1px var(--color-border);
        padding: 0.5rem;
        max-height: 70vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
</style>

<style is:global>
    /* Reuse global search item styles for consistency */
    #page-search-results .page-search-item {
        display: flex;
        align-items: center; /* Row layout for better list view in dedicated search */
        gap: 1rem;
        padding: 0.75rem;
        text-decoration: none;
        color: var(--color-text);
        border-radius: 8px;
        transition: background 0.2s;
    }

    #page-search-results .page-search-item:hover {
        background-color: var(--color-surface-hover);
    }

    #page-search-results .page-search-img-wrapper {
        width: 60px !important;
        height: 60px !important;
        border-radius: 8px;
        overflow: hidden;
        flex-shrink: 0 !important;
        background: #f0f0f0;
    }

    #page-search-results .page-search-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    #page-search-results .search-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    #page-search-results .search-title {
        font-weight: 500;
        font-size: 1rem;
    }

    #page-search-results .search-meta {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    #page-search-results .star-icon {
        color: #fbbf24;
        font-size: 0.8rem;
    }

    #page-search-results .no-results {
        padding: 2rem;
        text-align: center;
        color: var(--color-text-secondary);
    }
</style>
